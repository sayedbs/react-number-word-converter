{
  "name": "react-number-word-converter",
  "version": "1.0.0",
  "description": "A React utility plugin that converts numeric values into number words",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rollup -c",
    "dev": "rollup -c -w",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "demo": "npm run build && npm pack && cd demo && npm install ../react-number-word-converter-$npm_package_version.tgz && npm start",
    "demo:install": "npm run build && npm pack && cd demo && npm install ../react-number-word-converter-$npm_package_version.tgz",
    "prepublishOnly": "npx tsc"
  },
  "keywords": [
    "react",
    "number-word",
    "bengali",
    "number",
    "converter",
    "words",
    "i18n",
    "internationalization",
    "number-to-words"
  ],
  "author": "Sayed021",
  "license": "MIT",
  "peerDependencies": {
    "react": ">=16.8.0",
    "react-dom": ">=16.8.0"
  },
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/preset-env": "^7.23.0",
    "@babel/preset-react": "^7.22.0",
    "@babel/preset-typescript": "^7.23.0",
    "@rollup/plugin-babel": "^6.0.4",
    "@rollup/plugin-commonjs": "^25.0.7",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-terser": "^0.4.4",
    "@testing-library/jest-dom": "^6.1.4",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^14.5.1",
    "@types/jest": "^29.5.14",
    "@types/react": "^18.2.37",
    "@types/react-dom": "^18.2.15",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "rollup": "^4.6.1",
    "rollup-plugin-dts": "^6.1.0",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "ts-jest": "^29.4.4",
    "typescript": "^5.2.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Sayed021/react-number-word-converter.git"
  },
  "bugs": {
    "url": "https://github.com/Sayed021/react-number-word-converter/issues"
  },
  "homepage": "https://github.com/Sayed021/react-number-word-converter#readme"
}
